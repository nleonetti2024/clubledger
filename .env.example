# Copy to .env and adjust. Never commit .env.

# Sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CLUBLEDGER_SECRET_KEY=change-me-to-a-long-random-string

# PIN for the treasurer role (demo value).
CLUBLEDGER_TREASURER_PIN=4010

# auto = use the AI extractor if ANTHROPIC_API_KEY is set, otherwise the offline reader
# anthropic = always use the AI extractor (fails at start-up without a key)
# mock = always use the offline reader
CLUBLEDGER_EXTRACTOR=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
CLUBLEDGER_AI_TIMEOUT=20

# Fixed "today" so the sample receipts' ages are the same in every demo.
# Remove this line to use the real date.
CLUBLEDGER_AS_OF=2026-11-15

# CLUBLEDGER_DATABASE=instance/clubledger.sqlite3
# CLUBLEDGER_POLICY=policy/club_policy.yaml
